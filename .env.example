# Copy to .env.local (for the Next.js app) and/or set these as GitHub Actions
# secrets (for the scrapers). Never commit a real .env file. This file is
# .gitignore'd (matched by the broad .env* rule) and isn't tracked in git —
# delivered as a standalone file, not through a PR.

# --- Used by the Next.js frontend (safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# --- Used by the Next.js app's server-side API route
#     (app/api/check-eligibility/route.ts) — set these on Vercel too, not
#     just GitHub Actions. Never prefix these with NEXT_PUBLIC_: they must
#     stay server-side only. ---
GEMINI_API_KEY=your-gemini-api-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# --- Used by the scrapers (scripts/scan.mjs, scripts/social_discover.py,
#     scripts/gemini_discover.py) — server-side / GitHub Actions secrets only ---
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is shared with the API route above — same value,
# set separately in each place (GitHub Actions secrets vs. Vercel env vars
# don't share a store).
GROQ_API_KEY=gsk_...
BRIGHTDATA_API_KEY=your-brightdata-api-key
# GEMINI_API_KEY is shared with the API route above too.

# --- Optional: scripts/scan.mjs's Google Search discovery step. If either is
#     missing, that step is skipped gracefully (logs a notice, no crash). ---
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_CX=your-programmable-search-engine-id
