# Copy to .env.local (for the Next.js app) and/or set these as GitHub Actions
# secrets (for the scraper). Never commit a real .env file.

# --- Used by the Next.js frontend (safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# --- Used by the scraper (scripts/scan.mjs) — server-side / GitHub Actions only ---
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
GROQ_API_KEY=gsk_...
